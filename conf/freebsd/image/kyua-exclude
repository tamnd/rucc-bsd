# Tests left out of the kyua run. boot.sh puts this file on the rb disk, so a change here needs no new image.
# A line is a directory under /usr/tests, or a directory and a test program as DIR:PROGRAM.
# R and G leave out the same tests. A test program left out here is never graded.
sys/cddl/zfs	# ci runs it in its own test_zfs job, with five 8 GB disks, a 32 GB scratch disk and 90 minutes. The test VM has five 128 MB disks, and kyua has 13500 s for all the other tests
lib/libcasper/services/cap_dns:dns_test	# needs DNS on the internet. The test VM has no route out (restrict=on)
lib/libcasper/services/cap_net:net_test	# the same
