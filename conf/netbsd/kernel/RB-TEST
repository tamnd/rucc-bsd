# RB-TEST: the kernel configuration that rb boots to run the tests (plan 12.2). It is GENERIC of the
# pinned tree with options added and none removed. G and R use the same file. Each option tells
# which part of the rig needs it.
#
# build.sh takes the file by its path: build.sh kernel=/path/to/conf/netbsd/kernel/RB-TEST.
# config(8) reads the include from the tree's sys directory.

include 	"arch/amd64/conf/GENERIC"

# rb boot reads the console on the first serial port at 115200, the speed that rb image gives the
# boot blocks and boot.cfg. The kernel keeps that console also when the loader gives it no
# console information.
options 	CONSDEVNAME="\"com\"",CONADDR=0x3f8,CONSPEED=115200
options 	CONS_OVERRIDE

# A panic prints a stack trace on the console (db_dumpstack, 1 by default) and does not stop at
# the ddb prompt, where no person is. The kernel continues to the dump and the reboot. rb boot
# sees the panic and the trace, and QEMU's -no-reboot stops the VM (sys/ddb/db_panic.c).
options 	DDB_ONPANIC=0
