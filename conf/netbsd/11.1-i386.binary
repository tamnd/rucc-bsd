# The official binary sets of NetBSD 11.1 for i386, with the SHA512 of each from the SHA512 file
# of the release. scripts/netbsd/official.sh reads this file when NB_PIN_FILE=11.1.pin and
# NB_MACHINE=i386. The release has no live image for i386, so the R image of the i386 row of tcg
# is made from these sets with R's kernel in place of kern-GENERIC (B12). The kernel sets are not
# here, and the X and debug sets are not used.
NB_PIN_BINARY_URL=https://cdn.netbsd.org/pub/NetBSD/NetBSD-11.1/i386/binary/sets
NB_PIN_BINARY_SETS="
