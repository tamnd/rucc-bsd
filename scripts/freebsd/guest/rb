#!/bin/sh
#
# rb-rc (plan 12.4). It runs last at boot. It reads the rb disk, a tar archive with no file system
# that holds rb.conf, runs the suites that rb.conf names, writes the results back to the same disk as
# a tar archive, and powers off. The console markers say only that the run started and finished.
#
# PROVIDE: rb
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: nojail

# rc.subr reads name, desc, rcvar and the _cmd variables.
# shellcheck disable=SC2034

. /etc/rc.subr

name="rb"
desc="Run the rucc-bsd suites"
rcvar="rb_enable"
start_cmd="rb_start"
stop_cmd=":"

load_rc_config $name
: "${rb_enable:=NO}"
: "${rb_disk:=/dev/vtbd1}"

PATH="${PATH}:/usr/local/sbin:/usr/local/bin"
export PATH

rb_say()
{
	echo "$*" > /dev/console
}

rb_start()
{
	local work out s rc

	rb_say "RB-READY $(uname -a)"
	work=/var/rb
	out=${work}/out
	rm -rf ${work}
	mkdir -p ${out}

	if ! tar -xf "${rb_disk}" -C "${work}" 2>/dev/null || [ ! -f ${work}/rb.conf ]; then
		rb_say "RB-NODISK ${rb_disk}"
		return 0
	fi
	RB_SUITES="boot"
	RB_POWEROFF="yes"
	# shellcheck disable=SC1091
	. "${work}/rb.conf"
	export RB_SMOKE_DISK RB_KYUA_FILTERS RB_KYUA_LIMIT

	# A kernel with DDB prints a backtrace on a panic and resets, so QEMU exits instead of waiting.
	# A kernel without DDB, like GENERIC of a release, prints the backtrace and reboots anyway.
	ddb script kdb.enter.panic="bt; show pcpu; reset" > /dev/null 2>&1 || true

	uname -a > ${out}/uname.txt
	cp /var/run/dmesg.boot ${out}/dmesg.boot 2>/dev/null || dmesg -a > ${out}/dmesg.boot
	kldstat > ${out}/kldstat.txt
	sysctl kern.compiler_version kern.osreldate kern.version hw.ncpu hw.physmem > ${out}/sysctl.txt 2>&1 || true

	for s in ${RB_SUITES}; do
		case ${s} in
		boot)
			echo "pass" > ${out}/boot.txt
			;;
		smoke)
			rb_say "RB-SUITE smoke"
			sh ${work}/smoke.sh ${out}/smoke
			;;
		kyua)
			rb_say "RB-SUITE kyua"
			sh ${work}/kyua.sh ${out}/kyua
			;;
		*)
			echo "unknown suite ${s}" >> ${out}/errors.txt
			;;
		esac
	done

	dmesg -a > ${out}/dmesg.end 2>/dev/null || dmesg > ${out}/dmesg.end
	rc=0
	tar -cf "${rb_disk}" -C "${work}" . || rc=$?
	rb_say "RB-DONE tar=${rc} smoke=$(cat ${out}/smoke/counts 2>/dev/null) kyua=$(cat ${out}/kyua/counts 2>/dev/null)"

	if [ "${RB_POWEROFF}" = "yes" ]; then
		shutdown -p now
	fi
}

run_rc_command "$1"
